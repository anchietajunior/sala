            color: var(--cor-suave);
            font-weight: 400;
        }
        .reveal .slides section.capa .rodape-capa {
            margin-top: 2em;
            font-size: 0.6em;
            color: #888;
            font-style: italic;
        }

        .reveal pre {
            box-shadow: none;
            font-size: 0.5em;
            line-height: 1.35;
            width: auto;
            max-width: 100%;
        }
        .reveal pre code {
            border-radius: 6px;
            padding: 14px 18px;
            max-height: 580px;
        }

        .reveal .diagrama {
            max-width: 100%;
            max-height: 500px;
            margin: 0 auto;
            display: block;
        }

        .reveal .resposta {
            margin-top: 0.5em;
            padding: 8px 14px;
            border-left: 3px solid var(--cor-destaque);
            background: #f7f9fc;
            font-size: 0.7em;
            color: #333;
            line-height: 1.5;
            text-align: left;
        }
        .reveal .resposta strong {
            color: var(--cor-destaque);
        }
        .reveal .resposta ol,
        .reveal .resposta ul {
            margin: 0.4em 0 0.2em 0;
            padding-left: 1.6em;
            display: block;
        }
        .reveal .resposta li {
            margin-bottom: 0.25em;
        }
        .reveal .resposta code {
            font-size: 0.95em;
        }
        .reveal .resposta pre {
            font-size: 0.85em;
