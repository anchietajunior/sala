    <style>
        :root {
            --r-main-font-size: 32px;
            --cor-destaque: #2c5d8a;
            --cor-suave: #5a7a9a;
        }

        .reveal h1, .reveal h2, .reveal h3, .reveal h4 {
            color: var(--cor-destaque);
            text-transform: none;
            font-weight: 600;
            letter-spacing: normal;
        }

        .reveal .slides section.capa h1 {
            font-size: 2.4em;
